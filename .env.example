# ─── Server (set these in Render → Environment) ───────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas recommended for production)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/devtrack?retryWrites=true&w=majority

# JWT — must be >= 32 random characters. Generate with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_string_before_deploying
JWT_EXPIRE=7d

# Your Vercel frontend URL (no trailing slash). Required to allow browser requests through CORS.
# Example: https://devtrack.vercel.app
CLIENT_URL=http://localhost:5173

# ─── Client (set these in Vercel → Settings → Environment Variables) ──────────
# Your Render backend URL — required in production, optional in local dev (proxy handles it)
# VITE_API_URL=https://devtrack-api-7usm.onrender.com/api
